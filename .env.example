# Optional local development proxy for a BookOrbit server without CORS.
# Copy to .env.local (ignored by Git) and set your server origin.
VITE_BOOKORBIT_PROXY_ORIGIN=
# Read-only is the default: only login, refresh, and catalog queries may POST.
AVID_PROXY_READ_ONLY=true

# Optional web provider login. Avid must be served at BookOrbit's configured APP_URL
# and own /oauth2-callback. Both values must match the server/provider deployment.
# These are public routing settings, never credentials. Leave blank unless configured.
VITE_OIDC_SERVER_URL=
VITE_OIDC_APP_URL=
