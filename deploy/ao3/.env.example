# A DNS name pointing at this host; Caddy obtains a publicly trusted TLS certificate.
AVID_AO3_HOST=ao3-companion.example.com
# Match the owner of the mode0600 pairing file on hosts using bind-backed Compose secrets.
AVID_AO3_UID=1000
AVID_AO3_GID=1000
# Include only the actual Avid clients you use. No wildcard or null origin.
AVID_AO3_ORIGINS=capacitor://localhost,https://localhost,tauri://localhost,http://tauri.localhost,https://avid.example.com
