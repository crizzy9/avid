<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <!-- Only the isolated CrossPoint client resolves this reserved alias to validated LAN IPs. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">crosspoint.avid.invalid</domain>
    </domain-config>
</network-security-config>
