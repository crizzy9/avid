{
  "name": "@avid/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "cap sync",
    "add:ios": "cap add ios",
    "add:android": "cap add android",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "build:android": "cd android && ./gradlew :app:assembleDebug",
    "verify:ios": "node scripts/verify-ios.mjs",
    "configure:ios": "node scripts/configure-ios.mjs && node scripts/configure-carplay.mjs && node scripts/configure-locales.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:android:auto": "cd android && ./gradlew :app:assembleDebug :app:testDebugUnitTest -PavidCarEnabled=true"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/android": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0"
  }
}
